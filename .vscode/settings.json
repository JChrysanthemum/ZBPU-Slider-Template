{
    "latex-workshop.latex.tools": [
        {
            // 编译工具和命令
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-shell-escape",
                "-8bit",
                "%DOCFILE%"
            ],
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%DOCFILE%"
            ]
        },
        {
            "name": "clean_beamer_cache",
            "command": "cmd.exe",
            "args": [
                "/c",
                "del /q *.nav *.snm *.vrb *.synctex.gz"
            ]
        }
    ],

    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex",
            "tools": [
                "xelatex"
            ],
        },
        {
            "name": "xe->xe",
            "tools": [
                "xelatex",
                "xelatex",
                "clean_beamer_cache"
            ]
        },
        {
            "name": "pdf->bib->pdf->pdf",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "xe->xe",

    // 设置编译成功后自动清理
    "latex-workshop.latex.autoClean.run": "onBuilt",

    // （可选）自定义需要清理的文件后缀类型
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.gls",
        "*.ist",
        "*.fls",
        "*.log",
        "*.nav",
        "*.snm",
        "*.gz",
        "*.vrb",
        "*.fdb_latexmk",
        "*.synctex.gz",
        "*.minted",
    ]
}